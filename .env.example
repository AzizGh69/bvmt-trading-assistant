# Copy to .env and adjust. Every value is optional: the app runs with none set.
# Never commit a real .env.

# --- Database -----------------------------------------------------------------
# docker compose builds DATABASE_URL from these three. Outside Docker, leave
# DATABASE_URL unset to use a local SQLite file (bvmt.db), or point it at your
# own PostgreSQL: postgresql://user:password@localhost:5432/bvmt
POSTGRES_USER=bvmt
POSTGRES_PASSWORD=bvmt
POSTGRES_DB=bvmt
# DATABASE_URL=

# --- API ----------------------------------------------------------------------
# Secret used to sign login tokens. Empty = a random one per start (sessions end
# on restart). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Annual risk-free rate used by the Sharpe ratio.
RISK_FREE_RATE=0.07

# --- Web UI -------------------------------------------------------------------
# Where the browser reaches the API (baked into the web build).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (optional) -----------------------------------------------------------
# One OpenAI-compatible endpoint serves sentiment, the chat and explanations.
# Without LLM_API_KEY, sentiment uses the built-in lexicon scorer and the chat
# answers that it is not configured.
#   OpenAI:     https://api.openai.com/v1          e.g. gpt-4o-mini
#   Groq:       https://api.groq.com/openai/v1     e.g. llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1       e.g. meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Live news scraping (optional, off by default) ----------------------------
ENABLE_SCRAPING=false
# Comma-separated RSS feeds read when scraping is enabled.
NEWS_FEEDS=https://www.webdo.tn/fr/feed/,https://kapitalis.com/tunisie/feed/,https://africanmanager.com/feed/
SCRAPE_TIMEOUT_SECONDS=8

# --- E-mail alerts (optional) -------------------------------------------------
# Without SMTP_HOST, alert e-mails are written to the in-app outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bvmt-assistant@localhost

# --- Background jobs (optional) -----------------------------------------------
# Daily anomaly scan, alert e-mails and market report, run inside the API process.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=1440
